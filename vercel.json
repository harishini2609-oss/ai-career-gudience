{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "apps/api/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?realpath=/api/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?realpath=/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
