{
  "name": "ai-career-copilot",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "python -m uvicorn apps.api.main:app --reload --host 127.0.0.1 --port 8000",
    "build": "npm --prefix apps/web run build",
    "lint": "npm --prefix apps/web run lint",
    "install:all": "npm install && npm --prefix apps/web install && python -m pip install -r apps/api/requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
